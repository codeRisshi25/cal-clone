# Environment Variables — copy to .env and fill in values

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/calclone

# Redis
REDIS_URL=redis://localhost:6379

# Resend (email)
RESEND_API_KEY=RESEND_API_KEY_PLACEHOLDER

# Express API
PORT=8000
NODE_ENV=development

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000

# (Production only)
# ACR_LOGIN_SERVER=
# ACR_USERNAME=
# ACR_PASSWORD=
# ACI_RESOURCE_GROUP=
